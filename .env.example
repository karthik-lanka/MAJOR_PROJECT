# =============================================================================
# AI-Powered Multimodal Study Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual keys.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Gemini AI Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-2.0-flash
EMBEDDING_DIMENSION=768

# --- Pinecone Vector Database ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=study-assistant
PINECONE_NAMESPACE=default

# --- Document Processing ---
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
SUPPORTED_FILE_TYPES=pdf,txt,docx,png,jpg,jpeg

# --- Retrieval Configuration ---
RETRIEVAL_TOP_K=10
FINAL_CONTEXT_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# --- Web Search (Optional) ---
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
